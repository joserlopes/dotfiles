#!/usr/bin/env bash

if [ x"$@" = x"Thesis" ]
then
    xdg-open https://github.com/joserlopes/Thesis
    exit 0
elif [ x"$@" = x"PIC-2" ]
then
    xdg-open https://fenix.tecnico.ulisboa.pt/disciplinas/PMEIC2112/2025-2026/1-semestre
    exit 0
elif [ x"$@" = x"GitHub" ]
then
    xdg-open https://github.com/joserlopes
    exit 0
elif [ x"$@" = x"dotfiles" ]
then
    xdg-open https://github.com/joserlopes/dotfiles
    exit 0
fi

echo -e "Thesis\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "PIC-2\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "GitHub\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "dotfiles\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"

# echo -e "AAv-folder\x00icon\x1f/usr/share/icons/Papirus/16x16/places/folder.svg"
