#!/usr/bin/env bash

if [ x"$@" = x"Thesis" ]
then
    xdg-open https://github.com/joserlopes/Thesis
    exit 0
elif [ x"$@" = x"Thesis-Writeup" ]
then
    xdg-open https://typst.app/project/wTVaVryqe0q6vQS2y14lOC
    exit 0
elif [ x"$@" = x"Timely" ]
then
    xdg-open https://github.com/joserlopes/Timely.js
    exit 0
elif [ x"$@" = x"Type-Inference" ]
then
    xdg-open https://github.com/huiyu-mcse/Type-Inference
    exit 0
elif [ x"$@" = x"GitHub" ]
then
    xdg-open https://github.com/joserlopes
    exit 0
elif [ x"$@" = x"dotfiles" ]
then
    xdg-open https://github.com/joserlopes/dotfiles
    exit 0
fi

echo -e "Thesis\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "Thesis-Writeup\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "Timely\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "Type-Inference\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "GitHub\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "dotfiles\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"

# echo -e "AAv-folder\x00icon\x1f/usr/share/icons/Papirus/16x16/places/folder.svg"
