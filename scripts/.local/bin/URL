#!/usr/bin/env bash

if [ x"$@" = x"CMU" ]
then
    xdg-open https://fenix.tecnico.ulisboa.pt/disciplinas/CMov236/2024-2025/2-semestre
    exit 0
elif [ x"$@" = x"CMU-Project" ]
then
    xdg-open https://github.com/joserlopes/CMU-ChargIST
    exit 0
elif [ x"$@" = x"LP" ]
then
    xdg-open https://fenix.tecnico.ulisboa.pt/disciplinas/LPro36/2024-2025/2-semestre
    exit 0
elif [ x"$@" = x"LP-Project" ]
then
    xdg-open https://gitlab.rnl.tecnico.ulisboa.pt/ist1103938/lp-project
    exit 0
elif [ x"$@" = x"TVS" ]
then
    xdg-open https://fenix.tecnico.ulisboa.pt/disciplinas/TVS36/2024-2025/2-semestre
    exit 0
elif [ x"$@" = x"GitHub" ]
then
    xdg-open https://github.com/joserlopes
    exit 0
elif [ x"$@" = x"dotfiles" ]
then
    xdg-open https://github.com/joserlopes/dotfiles
    exit 0
fi

echo -e "CMU\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "CMU-Project\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "LP\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "LP-Project\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "TVS\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "GitHub\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "dotfiles\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"

# echo -e "AAv-folder\x00icon\x1f/usr/share/icons/Papirus/16x16/places/folder.svg"
