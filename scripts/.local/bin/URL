#!/usr/bin/env bash

if [ x"$@" = x"AAv" ]
then
    xdg-open https://fenix.tecnico.ulisboa.pt/disciplinas/AAva36/2024-2025/2-semestre
    exit 0
elif [ x"$@" = x"AAv-proj" ]
then
    xdg-open https://github.com/joserlopes/AAv
    exit 0
elif [ x"$@" = x"AAv-mooshak" ]
then
    xdg-open http://acp.tecnico.ulisboa.pt/~mooshak/
    exit 0
elif [ x"$@" = x"AAv-folder" ]
then
    nemo ~/Técnico/AAv/
    exit 0
elif [ x"$@" = x"PAv" ]
then
    xdg-open https://fenix.tecnico.ulisboa.pt/disciplinas/PAva36/2024-2025/2-semestre
    exit 0
elif [ x"$@" = x"PAv-proj" ]
then
    xdg-open https://github.com/joserlopes/Advanced-Programming
    exit 0
elif [ x"$@" = x"PAv-folder" ]
then
    nemo ~/Técnico/PAv/
    exit 0
elif [ x"$@" = x"CCEIC-II" ]
then
    xdg-open https://fenix.tecnico.ulisboa.pt/disciplinas/CCEIC236/2024-2025/2-semestre
    exit 0
elif [ x"$@" = x"GitHub" ]
then
    xdg-open https://github.com/joserlopes
    exit 0
elif [ x"$@" = x"dotfiles" ]
then
    xdg-open https://github.com/joserlopes/dotfiles
    exit 0
fi
echo -e "AAv\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "AAv-proj\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "AAv-mooshak\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "AAv-folder\x00icon\x1f/usr/share/icons/Papirus/16x16/places/folder.svg"
echo -e "PAv\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "PAv-proj\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "PAv-folder\x00icon\x1f/usr/share/icons/Papirus/16x16/places/folder.svg"
echo -e "CCEIC-II\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "GitHub\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
echo -e "dotfiles\x00icon\x1f/usr/share/icons/Papirus/22x22/actions/link.svg"
